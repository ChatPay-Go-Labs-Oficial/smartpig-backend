// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum IntentStatus {
  CREATED
  XDR_GENERATED
  SIGNED_XDR_RECEIVED
  SUBMITTED
  CONFIRMED
  FAILED
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum IntentType {
  DEPOSIT
  WITHDRAWAL
}

enum ManagedVaultStatus {
  PENDING_SIGNATURE
  SUBMITTED
  CONFIRMED
  FAILED
}

enum RampStatus {
  PENDING
  AWAITING_PAYMENT
  PROCESSING
  DELEGATION_NEEDED
  COMPLETED
  FAILED
  REFUNDED
}

enum EtherfuseKycStatus {
  NOT_STARTED
  PROPOSED
  APPROVED
  APPROVED_CHAIN_DEPLOYING
  REJECTED
}

/// Espelha o kyc_status do customer na BlindPay.
/// COMPLIANCE_REQUEST pausa o cliente enquanto um RFI está aberto;
/// APPROVED_RFI mantém o cliente operacional mesmo com RFI pendente.
enum BlindPayKycStatus {
  VERIFYING
  APPROVED
  REJECTED
  COMPLIANCE_REQUEST
  APPROVED_RFI
}

enum EtherfuseOrderDirection {
  ONRAMP
  OFFRAMP
}

enum EtherfuseOrderStatus {
  CREATED
  PENDING_SIGNATURE
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum WalletActivationStatus {
  NOT_STARTED
  PENDING_SIGNATURE
  SUBMITTING
  ACTIVATED
  FAILED
}

// ─────────────────────────────────────────────
// Auth & Users
// ─────────────────────────────────────────────

model User {
  id          String  @id @default(cuid())
  email       String? @unique
  name        String?
  avatarUrl   String?
  googleId    String? @unique
  appleId     String? @unique
  isOnboarded Boolean @default(false)

  /// Tombstone marker. Set by the scrub; the row survives so the retained
  /// financial records keep an anchor that points to nobody identifiable.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallets            WalletAccount[]
  depositIntents     DepositIntent[]
  withdrawalIntents  WithdrawalIntent[]
  transactions       TransactionRecord[]
  portfolioSnapshots PortfolioSnapshot[]
  refreshTokens      RefreshToken[]
  auditLogs          ApiAuditLog[]
  managedVaults      ManagedVault[]
  blindpayReceiver   BlindPayReceiver?
  onrampTxns         OnrampTransaction[]
  offrampTxns        OfframpTransaction[]
  etherfuseCustomer  EtherfuseCustomer?
  giftsSent          Gift[]                          @relation("giftsSent")
  giftsReceived      Gift[]                          @relation("giftsReceived")
  disclosureAcks     VaultDisclosureAcknowledgment[]

  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
// Wallets
// ─────────────────────────────────────────────

model WalletAccount {
  id                     String                 @id @default(cuid())
  userId                 String
  stellarAddress         String                 @unique
  label                  String?
  isActive               Boolean                @default(true)
  isActivated            Boolean                @default(false)
  activationStatus       WalletActivationStatus @default(NOT_STARTED)
  activationUnsignedXdr  String?                @db.Text
  activationExpiresAt    DateTime?
  activationTxHash       String?
  activationErrorMessage String?
  /// Real address, preserved by the scrub. `stellarAddress` gets a sentinel so the
  /// @unique constraint is freed and the same wallet can sign up again cleanly.
  archivedStellarAddress String?
  createdAt              DateTime               @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  depositIntents    DepositIntent[]
  withdrawalIntents WithdrawalIntent[]
  trustlines        WalletTrustline[]

  @@index([userId])
  @@map("wallet_accounts")
}

enum TrustlineStatus {
  PENDING_SIGNATURE
  ACTIVE
  FAILED
}

/// A non-funding asset trustline opened on demand.
///
/// Horizon stays the source of truth — `StellarService.hasTrustline` reads it
/// there. This table is a cache and an audit trail: it records which XDR we issued
/// and whether it landed, so a half-finished flow is recoverable and so the
/// deposit path can skip a Horizon round trip on the common case.
///
/// Separate from `WalletAccount.isActivated`, which keeps meaning "has the
/// trustlines onboarding creates". Widening that flag would report every existing
/// user as needing activation again.
model WalletTrustline {
  id              String          @id @default(cuid())
  walletAccountId String
  /// `EURC:GDHU…` — the same form `getWalletBalances` reports.
  assetId         String
  assetSymbol     String
  status          TrustlineStatus @default(PENDING_SIGNATURE)
  unsignedXdr     String?         @db.Text
  expiresAt       DateTime?
  txHash          String?
  errorMessage    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  walletAccount WalletAccount @relation(fields: [walletAccountId], references: [id], onDelete: Cascade)

  @@unique([walletAccountId, assetId])
  @@index([walletAccountId])
  @@map("wallet_trustlines")
}

// ─────────────────────────────────────────────
// Vaults
// ─────────────────────────────────────────────

model VaultCatalog {
  id              String    @id @default(cuid())
  defindexVaultId String    @unique
  name            String
  assetSymbol     String
  assetDecimals   Int       @default(7)
  description     String?
  apy             Decimal?  @db.Decimal(10, 4)
  tvl             Decimal?  @db.Decimal(30, 8)
  metadata        Json?
  /// Admin-owned. Means "listed and usable". The discovery job must never write it,
  /// otherwise a deactivation is undone on the next run.
  isActive        Boolean   @default(true)
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // ── Registry: admin-owned ──────────────────────────────────────────────
  /// Selects the VaultAdapter implementation.
  protocol            String  @default("DEFINDEX")
  /// When true the discovery job leaves name/assetSymbol/description alone.
  /// DeFindex reports XLM as "native" and sometimes a truncated contract id as the
  /// symbol, so curated rows must survive a sync.
  isCurated           Boolean @default(false)
  /// Freezes deposits while withdrawals stay open. Separate from isActive, which
  /// also gates createWithdrawal — a paused vault must not trap funds.
  depositsEnabled     Boolean @default(true)
  displayOrder        Int     @default(100)
  isFeatured          Boolean @default(false)
  /// The VaultConfigRecord: contract ids, strategies, roles, fees, liquidity,
  /// oracle and protocol dependencies, and the principal risks.
  configRecord        Json?
  configSchemaVersion Int     @default(1)
  /// Stellar Asset Contract id (C…) of the vault asset.
  assetContractId     String?

  // ── Registry: discovery-job-owned ──────────────────────────────────────
  /// What DeFindex last reported, kept apart from the curated values so the two
  /// provenances never overwrite each other.
  discoveredName        String?
  discoveredAssetSymbol String?
  /// Last time discovery still listed this vault. A vault disappearing upstream is
  /// observable without flipping isActive.
  lastSeenAt            DateTime?

  depositIntents     DepositIntent[]
  withdrawalIntents  WithdrawalIntent[]
  portfolioSnapshots PortfolioSnapshot[]
  managedVault       ManagedVault?
  disclosures        VaultDisclosure[]
  disclosureAcks     VaultDisclosureAcknowledgment[]

  @@index([isActive])
  @@index([isActive, displayOrder])
  @@map("vault_catalog")
}

// ─────────────────────────────────────────────
// Vault risk disclosures & acknowledgments
// ─────────────────────────────────────────────

/// A versioned, vault-specific risk disclosure.
///
/// `risks` holds structured entries, never prose: `[{ code, severity, params?,
/// fallbackText? }]`. The backend ships codes and numbers; the app writes the
/// sentence, so the Lite/Pro voice stays in the repo under code review. The
/// optional `fallbackText` exists because a published app cannot know a code added
/// after its release — without it, "update disclosures with no new release" and
/// "wording lives in the app" could not both be true.
model VaultDisclosure {
  id      String @id @default(cuid())
  vaultId String
  version Int

  risks    Json
  /// Plain-language principal risks plus liquidity and withdrawal conditions.
  sections Json?

  /// Null while a draft. Only a published row can be acknowledged, and a vault
  /// cannot be activated without one.
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  vault           VaultCatalog                    @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  acknowledgments VaultDisclosureAcknowledgment[]

  @@unique([vaultId, version])
  @@index([vaultId, publishedAt])
  @@map("vault_disclosures")
}

/// Proof that a user accepted a specific disclosure version for a specific vault.
///
/// The composite unique key is the whole enforcement rule: per user, per vault, per
/// version. Acknowledging vault A cannot satisfy vault B (vaultId is in the key),
/// and publishing a new version leaves no matching row, so consent is asked again
/// (version is in the key). Re-POSTing the same acceptance is idempotent.
model VaultDisclosureAcknowledgment {
  id             String   @id @default(cuid())
  userId         String
  vaultId        String
  disclosureId   String
  version        Int
  acknowledgedAt DateTime @default(now())
  /// Audit trail: the codes shown, the app version, and the Lite/Pro mode at the
  /// moment of consent.
  context        Json?

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vault      VaultCatalog    @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  disclosure VaultDisclosure @relation(fields: [disclosureId], references: [id])

  @@unique([userId, vaultId, version])
  @@index([userId, vaultId])
  @@index([disclosureId])
  @@map("vault_disclosure_acknowledgments")
}

// ─────────────────────────────────────────────
// Deposit Intents
// ─────────────────────────────────────────────

model DepositIntent {
  id              String       @id @default(cuid())
  idempotencyKey  String       @unique
  userId          String
  walletAccountId String
  vaultId         String
  amount          Decimal      @db.Decimal(30, 8)
  assetSymbol     String
  status          IntentStatus @default(CREATED)
  unsignedXdr     String?      @db.Text
  signedXdr       String?      @db.Text
  errorMessage    String?
  /// Machine-readable reason, so the app can tell REJECTED (user-actionable,
  /// retryable) apart from FAILED (chain or upstream).
  failureCode     String?
  expiresAt       DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user          User               @relation(fields: [userId], references: [id])
  walletAccount WalletAccount      @relation(fields: [walletAccountId], references: [id])
  vault         VaultCatalog       @relation(fields: [vaultId], references: [id])
  transaction   TransactionRecord?

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("deposit_intents")
}

// ─────────────────────────────────────────────
// Withdrawal Intents
// ─────────────────────────────────────────────

model WithdrawalIntent {
  id              String       @id @default(cuid())
  idempotencyKey  String       @unique
  userId          String
  walletAccountId String
  vaultId         String
  shareAmount     Decimal      @db.Decimal(30, 8)
  status          IntentStatus @default(CREATED)
  unsignedXdr     String?      @db.Text
  signedXdr       String?      @db.Text
  errorMessage    String?
  /// Machine-readable reason, so the app can tell REJECTED (user-actionable,
  /// retryable) apart from FAILED (chain or upstream).
  failureCode     String?
  expiresAt       DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user          User               @relation(fields: [userId], references: [id])
  walletAccount WalletAccount      @relation(fields: [walletAccountId], references: [id])
  vault         VaultCatalog       @relation(fields: [vaultId], references: [id])
  transaction   TransactionRecord?

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("withdrawal_intents")
}

// ─────────────────────────────────────────────
// Transactions
// ─────────────────────────────────────────────

model TransactionRecord {
  id                 String            @id @default(cuid())
  userId             String
  intentType         IntentType
  depositIntentId    String?           @unique
  withdrawalIntentId String?           @unique
  txHash             String?           @unique
  status             TransactionStatus @default(PENDING)
  blockchainResponse Json?
  createdAt          DateTime          @default(now())
  confirmedAt        DateTime?

  user             User              @relation(fields: [userId], references: [id])
  depositIntent    DepositIntent?    @relation(fields: [depositIntentId], references: [id])
  withdrawalIntent WithdrawalIntent? @relation(fields: [withdrawalIntentId], references: [id])

  @@index([userId])
  @@index([txHash])
  @@index([status])
  @@map("transaction_records")
}

// ─────────────────────────────────────────────
// Portfolio
// ─────────────────────────────────────────────

/// A daily point of a user's position in a vault.
///
/// Each row is self-describing on purpose: it carries the price and where that
/// price came from, so a historical value can be explained later instead of
/// being an unsourced number. It is a financial record.
model PortfolioSnapshot {
  id     String @id @default(cuid())
  userId String

  vaultId       String
  /// The underlying position in whole asset units.
  ///
  /// Used to hold raw share units, which nothing could interpret: the figure was
  /// neither the asset amount nor a value, and the column had no stated scale.
  balanceAmount Decimal  @db.Decimal(30, 8)
  /// Vault shares in whole units, kept separately from the underlying.
  shareAmount   Decimal? @db.Decimal(30, 8)
  /// Null when nothing could price the asset. Never a substituted guess — the
  /// snapshot is still taken, and the absence is the honest record.
  balanceUsd    Decimal? @db.Decimal(20, 4)
  /// The rate applied, so the row reproduces.
  priceUsd      Decimal? @db.Decimal(20, 8)
  /// `REFLECTOR` or `STATIC`. A constant must never be mistaken for a market price.
  priceSource   String?
  assetSymbol   String?

  capturedAt DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id])
  vault VaultCatalog @relation(fields: [vaultId], references: [id])

  @@index([userId, capturedAt])
  @@index([vaultId, capturedAt])
  @@map("portfolio_snapshots")
}

/// The price used on a given run, recorded once rather than per position.
///
/// Lets a day's valuation be audited without re-reading an oracle that only
/// serves the latest price.
model AssetPriceSnapshot {
  id          String   @id @default(cuid())
  assetSymbol String
  priceUsd    Decimal  @db.Decimal(20, 8)
  source      String
  /// The oracle's own timestamp, not when we read it.
  asOf        DateTime
  stale       Boolean  @default(false)
  capturedAt  DateTime @default(now())

  @@index([assetSymbol, capturedAt])
  @@map("asset_price_snapshots")
}

// ─────────────────────────────────────────────
// Vault Manager (SmartPig-owned vaults)
// ─────────────────────────────────────────────

model ManagedVault {
  id                    String             @id @default(cuid())
  creatorUserId         String
  callerAddress         String
  name                  String
  symbol                String
  description           String?
  vaultFeeBps           Int                @default(25)
  roles                 Json
  assets                Json
  status                ManagedVaultStatus @default(PENDING_SIGNATURE)
  unsignedXdr           String?            @db.Text
  signedXdr             String?            @db.Text
  predictedVaultAddress String?
  txHash                String?            @unique
  vaultCatalogId        String?            @unique
  errorMessage          String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  creator      User          @relation(fields: [creatorUserId], references: [id], onDelete: Cascade)
  vaultCatalog VaultCatalog? @relation(fields: [vaultCatalogId], references: [id])

  @@index([creatorUserId])
  @@index([status])
  @@map("managed_vaults")
}

// ─────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────

model ApiAuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  ipAddress  String?
  userAgent  String?
  payload    Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action, resource])
  @@map("api_audit_logs")
}

// ─────────────────────────────────────────────
// BlindPay On/Off Ramp
// ─────────────────────────────────────────────

model BlindPayReceiver {
  id                 String  @id @default(cuid())
  userId             String  @unique
  blindpayReceiverId String  @unique
  name               String
  taxId              String?
  /// ToS aceito na criação do customer. Guardado para reaproveitar no reenvio.
  tosId              String?

  kycStatus       BlindPayKycStatus @default(VERIFYING)
  /// kyc_warnings / fraud_warnings crus da BlindPay — o formato não é
  /// documentado, então guardamos o payload inteiro em vez de campos fixos.
  kycWarnings     Json?
  /// Mensagem de rejeição já achatada, para exibição e para o mapa pt-BR.
  rejectionReason String?
  kycUpdatedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccounts      BlindPayBankAccount[]
  blockchainWallets BlindPayBlockchainWallet[]
  onrampTxns        OnrampTransaction[]
  offrampTxns       OfframpTransaction[]
  kycAttempts       BlindPayKycAttempt[]

  @@index([blindpayReceiverId])
  @@map("blindpay_receivers")
}

/// Histórico de customers BlindPay rejeitados para este usuário.
///
/// A BlindPay não permite corrigir o KYC de um customer existente ("To retry
/// after a rejection, create a brand new customer"), então cada reenvio cria
/// um customer novo. O row de BlindPayReceiver é atualizado com o novo
/// blindpayReceiverId e o anterior é arquivado aqui — assim userId continua
/// @unique e não precisamos de índice único parcial.
model BlindPayKycAttempt {
  id                 String            @id @default(cuid())
  receiverId         String
  blindpayReceiverId String
  kycStatus          BlindPayKycStatus
  rejectionReason    String?
  warnings           Json?

  createdAt DateTime @default(now())

  receiver BlindPayReceiver @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId])
  @@map("blindpay_kyc_attempts")
}

model BlindPayBankAccount {
  id                    String  @id @default(cuid())
  receiverId            String
  blindpayBankAccountId String  @unique
  type                  String
  pixKey                String?
  isDefault             Boolean @default(false)

  createdAt DateTime @default(now())

  receiver    BlindPayReceiver     @relation(fields: [receiverId], references: [id], onDelete: Cascade)
  offrampTxns OfframpTransaction[]

  @@index([receiverId])
  @@map("blindpay_bank_accounts")
}

model BlindPayBlockchainWallet {
  id               String @id @default(cuid())
  receiverId       String
  blindpayWalletId String @unique
  network          String
  address          String

  createdAt DateTime @default(now())

  receiver   BlindPayReceiver    @relation(fields: [receiverId], references: [id], onDelete: Cascade)
  onrampTxns OnrampTransaction[]

  @@index([receiverId])
  @@map("blindpay_blockchain_wallets")
}

model OnrampTransaction {
  id                 String     @id @default(cuid())
  idempotencyKey     String     @unique
  userId             String
  receiverId         String
  blockchainWalletId String
  blindpayPayinId    String?    @unique
  blindpayQuoteId    String?
  amountBrl          Decimal    @db.Decimal(20, 2)
  amountUsdc         Decimal?   @db.Decimal(20, 6)
  pixCode            String?    @db.Text
  status             RampStatus @default(PENDING)
  errorMessage       String?
  completedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user             User                     @relation(fields: [userId], references: [id])
  receiver         BlindPayReceiver         @relation(fields: [receiverId], references: [id])
  blockchainWallet BlindPayBlockchainWallet @relation(fields: [blockchainWalletId], references: [id])

  @@index([userId, status])
  @@index([blindpayPayinId])
  @@map("onramp_transactions")
}

model OfframpTransaction {
  id                    String     @id @default(cuid())
  idempotencyKey        String     @unique
  userId                String
  receiverId            String
  bankAccountId         String
  blindpayPayoutId      String?    @unique
  blindpayQuoteId       String?
  amountUsdc            Decimal    @db.Decimal(20, 6)
  amountBrl             Decimal?   @db.Decimal(20, 2)
  senderWalletAddress   String
  unsignedDelegationXdr String?    @db.Text
  signedDelegationHash  String?
  status                RampStatus @default(PENDING)
  errorMessage          String?
  completedAt           DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  user        User                @relation(fields: [userId], references: [id])
  receiver    BlindPayReceiver    @relation(fields: [receiverId], references: [id])
  bankAccount BlindPayBankAccount @relation(fields: [bankAccountId], references: [id])

  @@index([userId, status])
  @@index([blindpayPayoutId])
  @@map("offramp_transactions")
}

// ─────────────────────────────────────────────
// Etherfuse Ramps
// ─────────────────────────────────────────────

model EtherfuseCustomer {
  id             String             @id @default(cuid())
  userId         String             @unique
  etherfuseOrgId String             @unique
  kycStatus      EtherfuseKycStatus @default(NOT_STARTED)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccounts EtherfuseBankAccount[]
  orders       EtherfuseOrder[]

  @@map("etherfuse_customers")
}

model EtherfuseBankAccount {
  id              String   @id @default(cuid())
  customerId      String
  etherfuseBankId String   @unique
  // SPEI (Mexico)
  clabe           String?
  // PIX (Brazil)
  pixKey          String?
  pixKeyType      String?
  rail            String   @default("spei") // "spei" | "pix"
  accountType     String
  isCompliant     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer EtherfuseCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders   EtherfuseOrder[]

  @@index([customerId])
  @@map("etherfuse_bank_accounts")
}

model EtherfuseOrder {
  id                String                  @id @default(cuid())
  idempotencyKey    String                  @unique
  customerId        String
  bankAccountId     String
  etherfuseOrderId  String?                 @unique
  etherfuseQuoteId  String
  direction         EtherfuseOrderDirection
  status            EtherfuseOrderStatus    @default(CREATED)
  sourceAsset       String
  targetAsset       String
  sourceAmount      Decimal                 @db.Decimal(30, 8)
  destinationAmount Decimal                 @db.Decimal(30, 8)
  walletAddress     String
  unsignedBurnXdr   String?                 @db.Text
  signedBurnXdr     String?                 @db.Text
  errorMessage      String?
  completedAt       DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  customer    EtherfuseCustomer    @relation(fields: [customerId], references: [id])
  bankAccount EtherfuseBankAccount @relation(fields: [bankAccountId], references: [id])

  @@index([customerId, status])
  @@map("etherfuse_orders")
}

// ─────────────────────────────────────────────
// Gifts — claimable-balance gifting
// ─────────────────────────────────────────────

enum GiftStatus {
  CREATED // intent created, awaiting on-chain funding
  FUNDED // claimable balance detected (balanceId set)
  CLAIMING // claim lock in progress
  CLAIMED // paid out to the recipient
  EXPIRED // passed expiresAt without a claim
  REFUNDED // sender reclaimed the balance after expiry
}

model Gift {
  id              String     @id @default(cuid())
  idempotencyKey  String     @unique
  code            String     @unique
  senderUserId    String
  senderWalletId  String
  recipientUserId String?
  amount          Decimal    @db.Decimal(30, 8)
  assetSymbol     String     @default("USDC")
  status          GiftStatus @default(CREATED)
  balanceId       String?
  fundingTxHash   String?
  claimTxHash     String?
  memo            String     @unique
  errorMessage    String?
  expiresAt       DateTime
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sender    User  @relation("giftsSent", fields: [senderUserId], references: [id])
  recipient User? @relation("giftsReceived", fields: [recipientUserId], references: [id])

  @@index([senderUserId, status])
  @@index([status, expiresAt])
  @@map("gifts")
}

// ─────────────────────────────────────────────
// Asset conversion (swap before deposit)
// ─────────────────────────────────────────────

enum ConversionStatus {
  CREATED
  XDR_GENERATED
  SIGNED_XDR_RECEIVED
  SUBMITTED
  CONFIRMED
  FAILED
  EXPIRED
}

/// A classic path payment that turns the funding asset into a vault's asset.
///
/// Exists because the ramp delivers USDC while the EURC and XLM vaults want their
/// own asset, and because the two cannot share a transaction: a path payment is a
/// classic operation and a DeFindex deposit is Soroban, which admits exactly one
/// operation per transaction.
///
/// `depositIntentId` stays null until the deposit it was meant for is created. A
/// row left CONFIRMED with no deposit is the recovery record: the user holds the
/// converted asset and still owes the deposit, which `plannedDeposit` describes.
model AssetConversion {
  id             String @id @default(cuid())
  idempotencyKey String @unique

  userId          String
  walletAccountId String

  /// Set once the deposit this conversion funded exists.
  depositIntentId String? @unique
  /// What the conversion was for, so an unconsumed one is resumable.
  plannedDeposit  Json?

  sourceAssetId String
  targetAssetId String
  sourceSymbol  String
  targetSymbol  String

  /// Whole units. `destMin` is the slippage floor the operation enforces: below
  /// it the payment fails atomically and nothing moves.
  sendAmount       Decimal  @db.Decimal(30, 8)
  quotedDestAmount Decimal  @db.Decimal(30, 8)
  destMin          Decimal  @db.Decimal(30, 8)
  slippageBps      Int
  /// Read from the transaction result, never from the quote.
  receivedAmount   Decimal? @db.Decimal(30, 8)

  /// The intermediate assets of the route, as Horizon reported them.
  path Json

  status       ConversionStatus @default(CREATED)
  unsignedXdr  String?          @db.Text
  signedXdr    String?          @db.Text
  txHash       String?          @unique
  failureCode  String?
  errorMessage String?

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("asset_conversions")
}

// ─────────────────────────────────────────────
// App Version Config — force update / update banner
// ─────────────────────────────────────────────

enum AppPlatform {
  IOS
  ANDROID
}

model AppVersionConfig {
  id            String      @id @default(cuid())
  platform      AppPlatform @unique
  minVersion    String // versão mínima obrigatória (semver "x.y.z") — abaixo dela, bloqueia
  latestVersion String // versão recomendada/mais recente (semver "x.y.z") — banner dispensável
  storeUrl      String // URL da App Store / Play Store para essa plataforma
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("app_version_configs")
}

enum AccountDeletionStatus {
  REQUESTED
  PENDING_SIGNATURE
  CHAIN_CLOSED
  LOCAL_SCRUBBED
  COMPLETED
  FAILED
}

model AccountDeletionRequest {
  id                 String                @id @default(cuid())
  idempotencyKey     String                @unique
  /// Scalar on purpose: no FK to User, so the consent record outlives the scrub and
  /// stays readable whatever happens to the account it documents.
  userId             String
  /// The identity provider's user id (the Privy DID). The cleanup job needs it to
  /// retry the deletion there, and it cannot be derived after the scrub: the local
  /// wallet address is replaced by a sentinel.
  privyUserId        String?
  status             AccountDeletionStatus @default(REQUESTED)
  closureUnsignedXdr String?               @db.Text
  closureTxHash      String?
  /// Dust actually swept to the treasury, for accounting reconciliation.
  sweptAmount        Decimal?              @db.Decimal(30, 8)
  sweptAssetSymbol   String?
  /// Every asset swept, since the two scalars above can only describe one and a
  /// closure now sweeps whatever trustlines the account holds.
  sweptAssets        Json?
  /// The three acknowledgements, with timestamps. Proof of informed consent.
  acknowledgements   Json
  blindpayDeletedAt  DateTime?
  privyDeletedAt     DateTime?
  cleanupAttempts    Int                   @default(0)
  errorMessage       String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([status])
  @@index([userId])
  @@map("account_deletion_requests")
}
